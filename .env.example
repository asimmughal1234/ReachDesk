# Server
PORT=3000
# Postgres connection string, e.g. from Neon (use the pooled one with ?sslmode=require).
# Leave empty to use the built-in local database in data/pglite.
DATABASE_URL=
# Public address used in unsubscribe links (set this when deployed)
PUBLIC_URL=http://localhost:3000
# Invite code people must enter to create an account. Share it only with your team.
# Leave empty to turn sign-up off (existing accounts can still sign in).
SIGNUP_CODE=

# Optional default email sender (users can also enter their own in Settings)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM_NAME=
SMTP_REPLY_TO=

# Optional default WhatsApp Cloud API sender
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0

# Testing: MAIL_TRANSPORT=json processes emails without delivering them,
# WA_DRY_RUN=1 fakes WhatsApp sends
MAIL_TRANSPORT=
WA_DRY_RUN=

# Old JSON data file, copied into the database once on first start (default: ./data/db.json)
DATA_FILE=
