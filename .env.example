# Server
PORT=3000
# Public address used in unsubscribe links (set this when deployed)
PUBLIC_URL=http://localhost:3000
# Set a password to require sign-in. Leave empty for local use only.
APP_PASSWORD=

# Optional default email sender (users can also enter their own in Settings)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM_NAME=
SMTP_REPLY_TO=

# Optional default WhatsApp Cloud API sender
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0

# Testing: MAIL_TRANSPORT=json processes emails without delivering them,
# WA_DRY_RUN=1 fakes WhatsApp sends
MAIL_TRANSPORT=
WA_DRY_RUN=

# Where the data file lives (default: ./data/db.json)
DATA_FILE=
